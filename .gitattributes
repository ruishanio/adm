* text=auto eol=lf

# aapt 输出的 Android 二进制清单，不参与换行转换或文本合并
*.axml binary

# 原始第三方材料及源码归档按字节校验，不执行平台换行转换。
legal/** -text
legal/vendor/** -whitespace
legal/THIRD-PARTY-NOTICES.txt -whitespace
legal/WINDOWS-INSTALLER.txt -whitespace
*.crate binary

# 保留 scrcpy 上游许可原文，包括文件末尾的空行。
android/scrcpy-server/LICENSE -text -whitespace
