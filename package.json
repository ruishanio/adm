{
  "name": "android-device-manager",
  "productName": "Android Device Manager",
  "shortName": "ADM",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop Android device management via ADB",
  "author": "RuiNext",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "package:mac": "node scripts/package.mjs mac",
    "package:win": "node scripts/package.mjs win"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@tauri-apps/api": "2.12.4",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
