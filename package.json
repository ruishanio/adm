{
  "name": "android-device-manager",
  "productName": "Android Device Manager",
  "shortName": "ADM",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop Android device management via ADB",
  "author": "RuiNext",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "package:mac": "npm run build && node scripts/package.mjs mac",
    "package:win": "npm run build && node scripts/package.mjs win",
    "smoke:device": "tsx scripts/device-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  },
  "type": "module"
}
